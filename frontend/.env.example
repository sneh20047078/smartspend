VITE_API_BASE_URL=http://localhost:8000
# Local password-based accounts use the SQLite-backed API. Set to "local" for a
# passwordless, disposable development identity; set all Cognito values for AWS auth.
VITE_AUTH_MODE=secure
VITE_AWS_REGION=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
